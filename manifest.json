{
  "manifest_version": 3,
  "name": "小说悦读",
  "version": "0.2.12",
  "description": "沉浸式小说阅读模式：自动排版适应屏幕、字号行距可调、屏蔽广告与图片、预加载下一章无缝连读、目录快速跳转与阅读进度记录。",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "scripting",
    "activeTab",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "novel-yuedu@tywww.dev",
      "strict_min_version": "128.0"
    }
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "小说悦读（Alt+R / Mac ⌘⇧K 进入阅读模式）",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "commands": {
    "toggle-reader": {
      "suggested_key": {
        "default": "Alt+R",
        "mac": "Command+Shift+K"
      },
      "description": "进入 / 退出阅读模式"
    }
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["src/content/kbd-guard.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": [
        "src/lib/purify.min.js",
        "src/lib/Readability.js",
        "src/lib/Readability-readerable.js",
        "src/content/detector.js",
        "src/content/cleaner.js",
        "src/content/extractor.js",
        "src/content/next-chapter.js",
        "src/content/settings-panel.js",
        "src/content/reader-view.js",
        "src/content/main.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ad_domains",
        "enabled": false,
        "path": "rules/dnr-blocklist.json"
      }
    ]
  },
  "web_accessible_resources": [
    {
      "resources": ["rules/*.json"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ]
}
